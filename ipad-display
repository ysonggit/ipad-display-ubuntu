#!/usr/bin/env python3
"""Use an iPad as a second display on GNOME/Wayland (Ubuntu 22.04).

Creates a real virtual monitor through Mutter's ScreenCast.RecordVirtual,
encodes it to MJPEG with GStreamer and serves it to Safari on the iPad.
Touch input comes back over a WebSocket and is injected through Mutter's
RemoteDesktop API (one finger = mouse, two fingers = scroll, long press =
right click).

Stdlib + PyGObject/GStreamer only.  Run:  ./ipad-display --help
"""
import argparse, base64, hashlib, json, os, secrets, shutil, signal, socket, struct
import subprocess, sys, threading, time
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

import gi
gi.require_version("Gst", "1.0")
from gi.repository import Gio, GLib, Gst

SC = "org.gnome.Mutter.ScreenCast"
RD = "org.gnome.Mutter.RemoteDesktop"
DC = "org.gnome.Mutter.DisplayConfig"
BTN = {0: 0x110, 2: 0x111}  # JS button -> evdev BTN_LEFT / BTN_RIGHT


def log(*a):
    print("[ipad-display]", *a, flush=True)


CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "ipad-display")
SIZE_FILE = os.path.join(CFG_DIR, "size.json")


def fit_size(edge, vw, vh):
    """Monitor size with the viewport's aspect ratio and the given long edge (multiples of 8)."""
    r = min(vw, vh) / max(vw, vh)
    a, b = edge, max(64, int(round(edge * r / 8)) * 8)
    return (a, b) if vw >= vh else (b, a)


class Display:
    """Virtual monitor + GStreamer encoder + input injection."""

    def __init__(self, width, height, fps, quality, scale, position="right", auto=False, edge=1600):
        self.w, self.h, self.fps, self.quality, self.scale = width, height, fps, quality, scale
        self.position, self.auto, self.edge = position, auto, edge
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.rd_session = self.sc_session = self.stream = self.sub = None
        self.frame = None
        self.cond = threading.Condition()
        self.seq = 0
        self.loop = GLib.MainLoop()
        self.pipeline = None
        self.refit_timer = None
        self.restarting = False

    def _call(self, name, path, iface, method, args, rtype):
        return self.bus.call_sync(name, path, iface, method, args,
                                  GLib.VariantType(rtype) if rtype else None,
                                  Gio.DBusCallFlags.NONE, 5000, None)

    def start(self):
        r = self._call(RD, "/org/gnome/Mutter/RemoteDesktop", RD, "CreateSession", None, "(o)")
        self.rd_session = r[0]
        sid = self._call(RD, self.rd_session, "org.freedesktop.DBus.Properties", "Get",
                         GLib.Variant("(ss)", (RD + ".Session", "SessionId")), "(v)")[0]
        r = self._call(SC, "/org/gnome/Mutter/ScreenCast", SC, "CreateSession",
                       GLib.Variant("(a{sv})", ({"remote-desktop-session-id": GLib.Variant("s", sid)},)), "(o)")
        self.sc_session = r[0]
        r = self._call(SC, self.sc_session, SC + ".Session", "RecordVirtual",
                       GLib.Variant("(a{sv})", ({"cursor-mode": GLib.Variant("u", 1)},)), "(o)")
        self.stream = r[0]
        self.sub = self.bus.signal_subscribe(SC, SC + ".Stream", "PipeWireStreamAdded", self.stream,
                                             None, Gio.DBusSignalFlags.NONE, self._on_node)
        self._call(RD, self.rd_session, RD + ".Session", "Start", None, "()")
        self.restarting = False

    def _on_node(self, _c, _s, _p, _i, _sig, params):
        node = params[0]
        log(f"PipeWire node {node}, requesting {self.w}x{self.h} @ max {self.fps} fps")
        # max-framerate makes Mutter itself throttle: it only reads back (and sends) <= fps frames
        # per second.  Frames are also dropped *before* videoconvert so a late burst costs nothing.
        desc = (f"pipewiresrc name=src path={node} do-timestamp=true ! "
                f"video/x-raw,width={self.w},height={self.h},max-framerate={self.fps}/1 ! "
                "videoconvert n-threads=2 ! "
                f"jpegenc quality={self.quality} ! "
                "appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false")
        self.pipeline = Gst.parse_launch(desc)
        self._last = 0.0
        self.pipeline.get_by_name("src").get_static_pad("src").add_probe(
            Gst.PadProbeType.BUFFER, self._throttle)
        self.pipeline.get_by_name("sink").connect("new-sample", self._on_sample)
        self.pipeline.set_state(Gst.State.PLAYING)
        GLib.timeout_add(1500, self._apply_layout)

    def _throttle(self, _pad, _info):
        now = time.monotonic()
        if now - self._last < 0.9 / self.fps:
            return Gst.PadProbeReturn.DROP
        self._last = now
        return Gst.PadProbeReturn.OK

    def _on_sample(self, sink):
        s = sink.emit("pull-sample")
        buf = s.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            data = bytes(info.data)
            buf.unmap(info)
            with self.cond:
                self.frame, self.seq = data, self.seq + 1
                self.cond.notify_all()
        return Gst.FlowReturn.OK

    def _apply_layout(self):
        """Place the virtual monitor (left/right/above/below) and give it a HiDPI scale."""
        if self.position == "right" and self.scale == 1:
            return False
        try:
            st = self._call(DC, "/org/gnome/Mutter/DisplayConfig", DC, "GetCurrentState", None, None)
            serial, monitors, logicals, props = st[0], st[1], st[2], st[3]
            phys = props.get("layout-mode", 1) == 2
            cur, dim = {}, {}
            for spec, modes, _ in monitors:
                for m in modes:
                    if m[6].get("is-current"):
                        cur[spec[0]], dim[spec[0]] = m[0], (m[1], m[2])
            items, virt = [], None
            for x, y, sc, tr, prim, specs, _ in logicals:
                is_v = any(s[0].startswith("Meta-") for s in specs)
                sc = float(self.scale) if is_v else sc
                w, h = dim[specs[0][0]]
                if tr in (1, 3, 5, 7):
                    w, h = h, w
                if not phys:
                    w, h = w / sc, h / sc
                it = [x, y, sc, tr, prim, [(s[0], cur[s[0]], {}) for s in specs], int(w), int(h)]
                items.append(it)
                if is_v:
                    virt = it
            if virt is None:
                return False
            others = [i for i in items if i is not virt]
            vw, vh = virt[6], virt[7]
            if others:
                minx, miny = min(i[0] for i in others), min(i[1] for i in others)
                maxx, maxy = max(i[0] + i[6] for i in others), max(i[1] + i[7] for i in others)
                pos = self.position
                if pos == "right":
                    virt[0], virt[1] = maxx, miny
                elif pos == "below":
                    virt[0], virt[1] = minx, maxy
                elif pos == "left":
                    for i in others:
                        i[0] += vw
                    virt[0], virt[1] = minx, miny
                elif pos == "above":
                    for i in others:
                        i[1] += vh
                    virt[0], virt[1] = minx, miny
            new = [(i[0], i[1], i[2], i[3], i[4], i[5]) for i in items]
            self._call(DC, "/org/gnome/Mutter/DisplayConfig", DC, "ApplyMonitorsConfig",
                       GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, 1, new, {})), None)
            log(f"virtual monitor: {self.position} of the built-in display, scale {self.scale}")
        except Exception as e:
            log("could not arrange the monitor:", e)
        return False

    # --- fit the monitor to the iPad's viewport --------------------------
    def request_fit(self, vw, vh):
        """Called (from any thread) when the iPad reports its viewport size."""
        if not self.auto or vw < 100 or vh < 100:
            return
        GLib.idle_add(self._schedule_fit, float(vw), float(vh))

    def _schedule_fit(self, vw, vh):
        tw, th = fit_size(self.edge, vw, vh)
        if abs((tw / th) / (self.w / self.h) - 1) < 0.03:
            if self.refit_timer:
                GLib.source_remove(self.refit_timer)
                self.refit_timer = None
            return False
        if self.refit_timer:
            GLib.source_remove(self.refit_timer)
        self.refit_timer = GLib.timeout_add(1200, self._refit, tw, th)  # debounce rotation / bars
        return False

    def _refit(self, tw, th):
        self.refit_timer = None
        log(f"iPad viewport is {tw}x{th} shaped: recreating the virtual monitor (was {self.w}x{self.h})")
        self.restarting = True
        self.teardown()
        self.w, self.h = tw, th
        try:
            os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
            with open(SIZE_FILE, "w") as f:
                json.dump({"w": tw, "h": th}, f)
        except OSError:
            pass
        GLib.timeout_add(800, lambda: (self.start(), False)[1])
        return False

    # --- input -----------------------------------------------------------
    def _notify(self, method, fmt, args):
        if not self.rd_session or self.restarting:
            return
        self.bus.call(RD, self.rd_session, RD + ".Session", method,
                      GLib.Variant(fmt, args), None, Gio.DBusCallFlags.NO_AUTO_START, -1, None, None, None)

    def handle_input(self, m):
        t = m.get("t")
        if t == "m":
            self._notify("NotifyPointerMotionAbsolute", "(sdd)",
                         (self.stream, m["x"] * self.w, m["y"] * self.h))
        elif t in ("d", "u"):
            self._notify("NotifyPointerButton", "(ib)", (BTN.get(m.get("b", 0), 0x110), t == "d"))
        elif t == "s":
            self._notify("NotifyPointerAxis", "(ddu)", (float(m.get("dx", 0)), float(m.get("dy", 0)), 0))
        elif t == "v":
            self.request_fit(float(m["w"]), float(m["h"]))

    def teardown(self):
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        if self.sub is not None:
            self.bus.signal_unsubscribe(self.sub)
            self.sub = None
        path, self.rd_session = self.rd_session, None
        try:
            if path:
                self._call(RD, path, RD + ".Session", "Stop", None, "()")
        except Exception:
            pass

    stop = teardown


