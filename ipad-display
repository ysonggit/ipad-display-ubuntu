COOKIE = "ipd"
CODE_TTL = 1800          # seconds a pairing token/PIN stays valid
MAX_FAILS, LOCK_SECS = 5, 300


class Pairing:
    """One-time token + PIN pairing; paired browsers get a long-lived cookie."""

    def __init__(self, days, enabled=True):
        self.enabled = enabled
        self.ttl = days * 86400
        self.path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                                 "ipad-display", "devices.json")
        self.lock = threading.Lock()
        self.fails = {}
        self.devices = self._load()
        self.on_paired = None
        self.new_codes()

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f).get("devices", {})
        except (OSError, ValueError):
            return {}

    def _save(self):
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"devices": self.devices}, f, indent=1)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.path)

    def new_codes(self):
        self.token = secrets.token_urlsafe(16)
        self.pin = "%06d" % secrets.randbelow(10 ** 6)
        self.expires = time.time() + CODE_TTL

    @staticmethod
    def _h(v):
        return hashlib.sha256(v.encode()).hexdigest()

    def authed(self, cookie):
        if not self.enabled:
            return True
        if not cookie:
            return False
        with self.lock:
            d = self.devices.get(self._h(cookie))
            return bool(d) and d["created"] + self.ttl > time.time()

    def _issue(self, ua):
        cookie = secrets.token_urlsafe(32)
        name = "iPad" if "iPad" in ua else (ua[:40] or "browser")
        with self.lock:
            self.devices[self._h(cookie)] = {"name": name, "created": int(time.time())}
            self._save()
            self.new_codes()
        if self.on_paired:
            self.on_paired(name)
        return cookie

    def pair_token(self, token, ua):
        if time.time() < self.expires and secrets.compare_digest(token, self.token):
            return self._issue(ua)

    def pair_pin(self, pin, ip, ua):
        """Returns (cookie|None, error|None)."""
        with self.lock:
            n, until = self.fails.get(ip, (0, 0))
            if until > time.time():
                return None, "错误次数过多,请稍后再试 / Too many attempts, try later"
        if time.time() < self.expires and secrets.compare_digest(pin.strip(), self.pin):
            self.fails.pop(ip, None)
            return self._issue(ua), None
        with self.lock:
            n += 1
            self.fails[ip] = (0, time.time() + LOCK_SECS) if n >= MAX_FAILS else (n, 0)
        return None, "配对码错误 / Wrong code"

    def forget(self):
        with self.lock:
            self.devices = {}
            self._save()


def make_handler(disp, pairing):
    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def _cookie(self):
            c = SimpleCookie(self.headers.get("Cookie", ""))
            return c[COOKIE].value if COOKIE in c else ""

        def _authed(self):
            return pairing.authed(self._cookie())

        def _send(self, code, body=b"", ctype="text/html; charset=utf-8", headers=()):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            if body:
                self.wfile.write(body)

        def _set_cookie(self, cookie):
            return ("Set-Cookie", f"{COOKIE}={cookie}; Path=/; Max-Age={pairing.ttl}; HttpOnly; SameSite=Lax")

        def _pin_page(self, code=200, msg=""):
            m = f"<p class=e>{msg}</p>" if msg else ""
            self._send(code, PIN_PAGE.replace("__MSG__", m).encode())

        def _usb_ok(self):
            """In --usb mode only answer connections that arrived over the USB link."""
            if not USB["only"] or self.connection.getsockname()[0] in usb_ips():
                return True
            self.close_connection = True
            self._send(403, b"USB only")
            return False

        def do_GET(self):
            if not self._usb_ok():
                return
            u = urlparse(self.path)
            ua = self.headers.get("User-Agent", "")
            if u.path == "/pair":
                cookie = pairing.pair_token(parse_qs(u.query).get("t", [""])[0], ua)
                if cookie:
                    self._send(302, headers=[("Location", "/"), self._set_cookie(cookie)])
                else:
                    self._pin_page(403, "二维码已失效,请输入配对码 / QR expired, enter the code")
                return
            if u.path == "/":
                if self._authed():
                    self._send(200, PAGE.encode())
                else:
                    self._pin_page()
                return
            if not self._authed():
                self._send(401)
                return
            if u.path == "/ping":
                self._send(204)
            elif u.path == "/stream":
                self._stream()
            elif u.path == "/ws":
                self._ws()
            else:
                self._send(404)

        def do_POST(self):
            if not self._usb_ok():
                return
            n = min(int(self.headers.get("Content-Length") or 0), 1024)
            body = self.rfile.read(n).decode("utf-8", "replace")
            if urlparse(self.path).path != "/pin":
                self._send(404)
                return
            pin = parse_qs(body).get("pin", [""])[0]
            cookie, err = pairing.pair_pin(pin, self.client_address[0], self.headers.get("User-Agent", ""))
            if cookie:
                self._send(303, headers=[("Location", "/"), self._set_cookie(cookie)])
            else:
                self._pin_page(429 if "多" in err else 403, err)

        def _stream(self):
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=f")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            seq = 0
            try:
                while True:
                    with disp.cond:
                        if not disp.cond.wait_for(lambda: disp.seq != seq, timeout=1.0) and disp.frame is None:
                            continue
                        frame, seq = disp.frame, disp.seq
                    self.wfile.write(b"--f\r\nContent-Type: image/jpeg\r\nContent-Length: %d\r\n\r\n" % len(frame))
                    self.wfile.write(frame)
                    self.wfile.write(b"\r\n")
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            self.close_connection = True

        def _ws(self):
            key = self.headers.get("Sec-WebSocket-Key")
            origin = self.headers.get("Origin")
            if not key or (origin and urlparse(origin).netloc != self.headers.get("Host")):
                self._send(400)
                return
            acc = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
            self.send_response(101)
            self.send_header("Upgrade", "websocket")
            self.send_header("Connection", "Upgrade")
            self.send_header("Sec-WebSocket-Accept", acc)
            self.end_headers()
            self.wfile.flush()
            self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            rf = self.rfile
            try:
                while True:
                    b1, b2 = rf.read(2)
                    op, ln = b1 & 0x0F, b2 & 0x7F
                    if ln == 126:
                        ln = struct.unpack(">H", rf.read(2))[0]
                    elif ln == 127:
                        ln = struct.unpack(">Q", rf.read(8))[0]
                    mask = rf.read(4) if b2 & 0x80 else b"\0\0\0\0"
                    data = bytearray(rf.read(ln))
                    for i in range(len(data)):
                        data[i] ^= mask[i & 3]
                    if op == 8:
                        break
                    if op == 1:
                        try:
                            disp.handle_input(json.loads(data))
                        except (ValueError, KeyError, TypeError):
                            pass
            except (ValueError, OSError):
                pass
            self.close_connection = True

    return H


USB = {"only": False, "iface": None}   # set by --usb / --usb-iface
USB_GW = "172.20.10.1"                  # the iPad's own address on its Personal Hotspot link


def usb_links():
    """{iface: [ipv4,...]} for iPad/iPhone USB network links (ipheth driver, or --usb-iface)."""
    links = {}
    for dev in sorted(os.listdir("/sys/class/net")):
        drv = os.path.basename(os.path.realpath(f"/sys/class/net/{dev}/device/driver"))
        if drv == "ipheth" or dev == USB["iface"]:
            links[dev] = []
    out = subprocess.run(["ip", "-4", "-o", "addr", "show"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        f = line.split()
        if f[1] in links:
            links[f[1]].append(f[3].split("/")[0])
    return links


_usb_cache = [0.0, set()]


def usb_ips():
    if time.monotonic() - _usb_cache[0] > 1.5:
        _usb_cache[:] = [time.monotonic(), {ip for ips in usb_links().values() for ip in ips}]
    return _usb_cache[1]


def hosts():
    """Addresses to reach this machine, best first: USB-link IP, <host>.local, LAN IPs."""
    usb = sorted({ip for ips in usb_links().values() for ip in ips})
    if USB["only"]:
        return usb, bool(usb)
    lan = []
    out = subprocess.run(["ip", "-4", "-o", "addr", "show"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        ip = line.split()[3].split("/")[0]
        if not ip.startswith("127.") and ip not in usb:
            lan.append(ip)
    local = socket.gethostname().split(".")[0] + ".local"
    return usb + [local] + lan, bool(usb)


def usb_doctor():
    """Explain, step by step, what is missing for a USB-cable connection."""
    ok = lambda b: "\u2713" if b else "\u2717"
    print("iPad USB 连接诊断 / USB link diagnosis\n")
    lsusb = subprocess.run(["lsusb"], capture_output=True, text=True).stdout
    apple = [l for l in lsusb.splitlines() if "05ac:" in l and "iBridge" not in l]
    print(f" {ok(apple)} 1. USB 上检测到 iPad / iPad seen on USB")
    for l in apple:
        print("      " + l)
    if not apple:
        print("      插上数据线,iPad 解锁,弹出“信任此电脑”时点信任 / plug in, unlock, tap Trust")
    mod = subprocess.run(["modinfo", "ipheth"], capture_output=True).returncode == 0
    print(f" {ok(mod)} 2. 内核驱动 ipheth / kernel driver ipheth")
    mux = shutil.which("usbmuxd") is not None
    print(f" {ok(mux)} 3. usbmuxd 已安装 / usbmuxd installed (handles the Trust pairing)")
    if not mux:
        print("      sudo apt install usbmuxd libimobiledevice-utils")
    if shutil.which("idevicepair") and apple:
        r = subprocess.run(["idevicepair", "validate"], capture_output=True, text=True)
        print(f" {ok(r.returncode == 0)} 4. 已信任此电脑 / trusted: {(r.stdout or r.stderr).strip()}")
        if r.returncode:
            print("      idevicepair pair   (然后在 iPad 上点“信任” / then tap Trust on the iPad)")
    links = usb_links()
    print(f" {ok(links)} 5. USB 网络接口 / USB network interface: {', '.join(links) or 'none'}")
    if apple and not links:
        print("      iPad: 设置 → 个人热点 → 打开“允许其他人加入”(连着线即可,不用 Wi-Fi 密码)")
        print("      Settings > Personal Hotspot > Allow Others to Join")
        print("      注意:仅 Wi-Fi 版 iPad 没有个人热点,无法用 USB 网络,请改用 Wi-Fi")
        print("      Note: Wi-Fi-only iPads have no Personal Hotspot - use Wi-Fi instead")
    have_ip = any(links.values())
    print(f" {ok(have_ip)} 6. 已获得 IP / got an IP: " +
          ", ".join(f"{d}={'/'.join(v) or '-'}" for d, v in links.items()))
    if links and not have_ip:
        dev = next(iter(links))
        try:
            carrier = open(f"/sys/class/net/{dev}/carrier").read().strip() == "1"
        except OSError:
            carrier = False
        if not carrier:
            print("      没有载波:iPad 还没打开 USB 网络 / no carrier: the iPad has not enabled its side yet")
            print("      iPad 解锁 → 设置 → 个人热点 → 打开“允许其他人加入”,并在“信任此电脑”时点信任")
            print("      Unlock iPad > Settings > Personal Hotspot > Allow Others to Join; tap Trust if asked")
            print("      仍不行就拔掉线重插一次 / if it stays down, unplug and replug once")
        else:
            print(f"      nmcli device connect {dev}")
    if have_ip:
        dev = next(d for d, v in links.items() if v)
        r = subprocess.run(["ping", "-c", "1", "-W", "1", "-I", dev, USB_GW], capture_output=True)
        print(f" {ok(r.returncode == 0)} 7. 能连通 iPad / iPad reachable at {USB_GW}")
        print(f"\n  一切正常时运行 / when all good run:  ./ipad-display --usb")


def avahi_ok():
    return subprocess.run(["systemctl", "is-active", "--quiet", "avahi-daemon"]).returncode == 0


def show_pairing(pairing, port):
    hs, _ = hosts()
    if not hs:
        log("等待 iPad 通过 USB 连接… / waiting for the iPad on USB (--usb-doctor if it never shows up)")
        return
    base = lambda h: f"http://{h}" + ("" if port == 80 else f":{port}")
    print(flush=True)
    log("在 iPad 上用相机扫描二维码 / scan with the iPad camera:")
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "UTF8", "-m", "1", f"{base(hs[0])}/pair?t={pairing.token}"])
    else:
        log("(安装 qrencode 可显示二维码 / install qrencode for a QR code: sudo apt install qrencode)")
        print(f"    {base(hs[0])}/pair?t={pairing.token}", flush=True)
    log(f"或在 iPad Safari 打开 / or open in Safari: {base(hs[0])}   配对码 / PIN: {pairing.pin}")
    if len(hs) > 1:
        log("备用地址 / other addresses: " + "  ".join(base(h) for h in hs[1:]))
    log(f"已配对设备 / paired devices: {len(pairing.devices)}   (码 30 分钟内有效 / code valid 30 min)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--size", default="auto", help="'auto' (default): match the iPad's screen shape, long edge "
                    "--max-edge; or fixed WxH pixels, e.g. 2048x1536")
    ap.add_argument("--max-edge", type=int, default=1600, help="long edge in pixels for --size auto (default %(default)s; "
                    "bigger = sharper but heavier)")
    ap.add_argument("--position", default="right", choices=("left", "right", "above", "below"),
                    help="where the iPad monitor sits relative to the built-in display (default %(default)s)")
    ap.add_argument("--scale", type=int, default=1, choices=(1, 2), help="GNOME UI scale for the iPad monitor (2 = HiDPI)")
    ap.add_argument("--fps", type=int, default=30, help="max frames per second (default %(default)s)")
    ap.add_argument("--quality", type=int, default=None, help="JPEG quality 1-100 (default 75, 85 with --usb)")
    ap.add_argument("--port", type=int, default=8800, help="HTTP port; 80 gives a bare http://host.local URL "
                    "(needs: sudo sysctl net.ipv4.ip_unprivileged_port_start=80)")
    ap.add_argument("--cookie-days", type=int, default=90, help="how long a paired iPad stays paired (default %(default)s)")
    ap.add_argument("--no-pairing", action="store_true", help="disable authentication (trusted networks only!)")
    ap.add_argument("--list-devices", action="store_true", help="list paired devices and exit")
    ap.add_argument("--forget", action="store_true", help="unpair all devices and exit")
    ap.add_argument("--usb", action="store_true", help="USB cable only: serve only over the iPad's USB network link; "
                    "the monitor appears when the iPad is plugged in and goes away when unplugged")
    ap.add_argument("--usb-iface", default=None, help="treat this network interface as the iPad USB link")
    ap.add_argument("--usb-doctor", action="store_true", help="diagnose the USB-cable connection and exit")
    a = ap.parse_args()
    USB["only"], USB["iface"] = a.usb, a.usb_iface
    if a.quality is None:
        a.quality = 85 if a.usb else 75
    if a.usb_doctor:
        return usb_doctor()

    pairing = Pairing(a.cookie_days, enabled=not a.no_pairing)
    if a.list_devices:
        for d in pairing.devices.values():
            print(time.strftime("%Y-%m-%d %H:%M", time.localtime(d["created"])), d["name"])
        print(f"{len(pairing.devices)} device(s)")
        return
    if a.forget:
        n = len(pairing.devices)
        pairing.forget()
        print(f"forgot {n} device(s)")
        return

    auto = a.size.lower() == "auto"
    if auto:
        try:
            with open(SIZE_FILE) as f:
                d = json.load(f)
            w, h = int(d["w"]), int(d["h"])
            if max(w, h) != a.max_edge:
                w, h = fit_size(a.max_edge, w, h)
        except (OSError, ValueError, KeyError):
            w, h = fit_size(a.max_edge, 4, 3)
    else:
        w, h = (int(x) for x in a.size.lower().split("x"))
    try:
        srv = ThreadingHTTPServer(("0.0.0.0", a.port), make_handler(None, pairing))
    except PermissionError:
        sys.exit(f"cannot bind port {a.port}; run: sudo sysctl net.ipv4.ip_unprivileged_port_start={a.port}")
    Gst.init(None)
    disp = Display(w, h, a.fps, a.quality, a.scale, a.position, auto, a.max_edge)
    srv.RequestHandlerClass = make_handler(disp, pairing)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    if not a.usb or usb_ips():
        disp.start()
        log(f"virtual monitor {w}x{h} created")
    if a.no_pairing:
        log("WARNING: --no-pairing, anyone on the network can control this machine")
        log("open on the iPad: " + "  ".join(f"http://{x}:{a.port}" for x in hosts()[0]))
    else:
        if not avahi_ok():
            log("avahi-daemon 未运行,.local 地址可能无法使用 / avahi-daemon is not running, .local names may fail")
        show_pairing(pairing, a.port)
        pairing.on_paired = lambda name: GLib.idle_add(lambda: (log(f"已配对 / paired: {name}"),
                                                                  show_pairing(pairing, a.port), False)[-1])

        def refresh():
            if time.time() >= pairing.expires:
                pairing.new_codes()
                show_pairing(pairing, a.port)
            return True
        GLib.timeout_add_seconds(30, refresh)

    if a.usb:
        state = {"ips": usb_ips(), "lost": None}

        def watch_usb():
            ips = usb_ips()
            if ips != state["ips"]:
                state["ips"] = ips
                if ips:
                    log("iPad USB 已连接 / USB link up: " + ", ".join(sorted(ips)))
                    if state["lost"]:
                        GLib.source_remove(state["lost"])
                        state["lost"] = None
                    if not disp.rd_session:
                        disp.start()
                        log(f"virtual monitor {disp.w}x{disp.h} created")
                    if not a.no_pairing:
                        show_pairing(pairing, a.port)
                else:
                    log("iPad USB 已断开 / USB link down")

                    def drop():
                        state["lost"] = None
                        if not usb_ips():
                            disp.teardown()
                            log("virtual monitor removed (plug the iPad back in to restore it)")
                        return False
                    state["lost"] = GLib.timeout_add_seconds(5, drop)  # survive a quick replug
            return True
        GLib.timeout_add_seconds(2, watch_usb)

    def quit_(*_):
        disp.loop.quit()
    signal.signal(signal.SIGINT, quit_)
    signal.signal(signal.SIGTERM, quit_)
    GLib.timeout_add(250, lambda: True)  # let Python handle signals
    try:
        disp.loop.run()
    finally:
        log("stopping")
        disp.stop()
        srv.shutdown()


if __name__ == "__main__":
    sys.exit(main())
